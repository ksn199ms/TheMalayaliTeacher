# Application Environment
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/the-malayali-teacher

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# AI & Embedding Providers
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini Configuration (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=student_documents

# RAG & Chunking Settings
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
MAX_HISTORY_MESSAGES=10

# File Upload Settings
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./data/uploads

# Rate Limiting & Study Assistant Settings
QUESTIONS_PER_MINUTE=10
QUESTION_RATE_LIMIT_PER_MINUTE=10
STUDY_GENERATION_RATE_LIMIT_PER_MINUTE=5
STUDY_SESSION_TTL_MINUTES=60

# Context Budget Limits
MAX_SUMMARY_CONTEXT_CHUNKS=20
MAX_QUIZ_CONTEXT_CHUNKS=15
MAX_FLASHCARD_CONTEXT_CHUNKS=15
MAX_EXPLAIN_CONTEXT_CHUNKS=8

# V4 Advanced RAG Settings
RETRIEVAL_CANDIDATES=20
FINAL_CONTEXT_CHUNKS=6
MAX_QUERY_EXPANSIONS=2
ENABLE_QUERY_EXPANSION=false
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
ENABLE_GROUNDING_VALIDATION=true
SIMILARITY_THRESHOLD=0.25
RAG_DEBUG=false
INDEX_VERSION=2

# V4.1 Gemini Quota Management, Retries & Cost Optimization
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_RETRY_DELAY_MS=1000
GEMINI_MAX_RETRY_DELAY_MS=30000
GEMINI_RETRY_JITTER_MS=500
GEMINI_MAX_RETRY_TIME_MS=60000
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MAX_QUEUE_SIZE=20
MAX_GEMINI_CALLS_PER_USER_REQUEST=3
ENABLE_GEMINI_RERANKING=false
ENABLE_GEMINI_GROUNDING_CHECK=false
GEMINI_RESPONSE_CACHE_TTL_SECONDS=60
# V5 Web, Auth, Storage & Worker Settings
PORT=5000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=the_malayali_teacher_super_secret_jwt_key_min_32_chars_long!
JWT_EXPIRES_IN=7d

# Storage Configuration (local | s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=the-malayali-teacher-storage
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Queue & Worker Settings (optional Redis; in-memory fallback enabled if absent)
REDIS_URL=redis://localhost:6379
ENABLE_BACKGROUND_WORKER=true

