# Application Environment
NODE_ENV=production

# Server & Web
PORT=5000
CORS_ORIGIN=https://themalayaliteacher.yourdomain.com
JWT_SECRET=change_me_to_a_secure_random_64_character_string_in_production
JWT_EXPIRES_IN=7d

# MongoDB Production Connection (MongoDB Atlas or standalone MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/the-malayali-teacher?retryWrites=true&w=majority

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_MODE=polling # or webhook
# TELEGRAM_WEBHOOK_URL=https://themalayaliteacher.yourdomain.com

# AI & Embedding Providers
AI_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini

# Google Gemini API (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_production_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Qdrant Vector Database (Native binary or Qdrant Cloud)
# For local binary: http://localhost:6333
# For Qdrant Cloud: https://xxxx-xxxx.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=student_documents
# QDRANT_API_KEY=your_qdrant_cloud_api_key_if_using_cloud

# Storage Configuration (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=the-malayali-teacher-storage
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Worker & Redis Queue (Native / Redis Cloud / Upstash; in-memory fallback enabled if empty)
REDIS_URL=redis://localhost:6379
ENABLE_BACKGROUND_WORKER=true

# RAG & Pipeline
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
MAX_HISTORY_MESSAGES=10
RETRIEVAL_CANDIDATES=20
FINAL_CONTEXT_CHUNKS=6
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
ENABLE_GROUNDING_VALIDATION=true
SIMILARITY_THRESHOLD=0.25
RAG_DEBUG=false
INDEX_VERSION=2

# Rate Limits
QUESTIONS_PER_MINUTE=15
QUESTION_RATE_LIMIT_PER_MINUTE=15
STUDY_GENERATION_RATE_LIMIT_PER_MINUTE=6
STUDY_SESSION_TTL_MINUTES=60
MAX_FILE_SIZE_MB=25
